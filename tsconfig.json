{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["api", "packages", "scripts", "server", "src", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "firmware"]
}
